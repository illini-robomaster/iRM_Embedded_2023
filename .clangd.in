# Generated by CMake from .clangd.in. Local machine paths belong here,
# not in the tracked template.

CompileFlags:
  CompilationDatabase: build
  Remove:
    - -mthumb-interwork
    - -fdiagnostics-color=always
    - -Werror
  Add:
    - "--gcc-toolchain=@IRM_CLANGD_GCC_TOOLCHAIN_ROOT@"
    - -D__weak=__attribute__((weak))
    - -D__packed=__attribute__((__packed__))

---
If:
  PathMatch: .*\.c
CompileFlags:
  Compiler: "@IRM_CLANGD_C_COMPILER@"

---
If:
  PathMatch: .*\.(cc|cpp|cxx|hpp|hh|hxx)
CompileFlags:
  Compiler: "@IRM_CLANGD_CXX_COMPILER@"
  Add:
    - -stdlib=libstdc++
